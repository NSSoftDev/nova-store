{
  "name": "@nova/server",
  "version": "1.0.0",
  "private": true,
  "description": "Nova Store REST API — Node.js, Express, PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@nova/shared": "1.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.7.0-beta.19",
    "supertest": "^7.1.0"
  }
}
